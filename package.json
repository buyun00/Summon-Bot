{
  "name": "relay-bot",
  "version": "0.2.0",
  "private": true,
  "description": "Independent Pi Bots, external capabilities and a separate Web interface",
  "type": "module",
  "workspaces": [
    "bot",
    "web",
    "capabilities"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node scripts/installation/cli.mjs start",
    "relay:dev": "node scripts/installation/cli.mjs dev",
    "relay:build": "node scripts/build/build.mjs",
    "relay:pack": "node scripts/build/build.mjs --bundle-node",
    "relay:start": "node scripts/installation/cli.mjs start",
    "relay:migrate": "node scripts/migration/migrate.mjs",
    "relay:init": "node scripts/installation/cli.mjs init",
    "relay:install": "node scripts/installation/install.mjs",
    "relay:status": "node scripts/installation/cli.mjs status",
    "relay:stop": "node scripts/installation/cli.mjs stop",
    "relay:capabilities": "node scripts/installation/capabilities.mjs",
    "relay:history": "node scripts/maintenance/history.mjs"
  }
}
