{
  "name": "summon-bot",
  "version": "0.3.8",
  "private": true,
  "description": "Independent Pi Bots, external capabilities and a separate Web interface",
  "type": "module",
  "workspaces": [
    "bot",
    "web",
    "capabilities"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node scripts/installation/cli.mjs start",
    "summon:build": "node scripts/build/build.mjs",
    "summon:pack": "node scripts/build/build.mjs --bundle-node",
    "summon:start": "node scripts/installation/cli.mjs start",
    "summon:init": "node scripts/installation/cli.mjs init",
    "summon:install": "node scripts/installation/install.mjs",
    "summon:status": "node scripts/installation/cli.mjs status",
    "summon:stop": "node scripts/installation/cli.mjs stop",
    "summon:capabilities": "node scripts/installation/capabilities.mjs",
    "summon:history": "node scripts/maintenance/history.mjs",
    "release:version": "node scripts/release/cli.mjs version",
    "release:web": "node scripts/release/cli.mjs web",
    "release:desktop": "node scripts/release/cli.mjs desktop",
    "release:android": "node scripts/release/cli.mjs android",
    "release:ios": "node scripts/release/cli.mjs ios",
    "release:publish": "node scripts/release/cli.mjs publish",
    "release:all": "node scripts/release/cli.mjs all"
  }
}
