{
  "name": "@summon/bot",
  "version": "0.3.18",
  "description": "Independent Pi Agent with durable messages, tasks, state and configured capabilities",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./store": "./src/storage/store.mjs",
    "./tools": "./src/capabilities/registry.mjs",
    "./process-log": "./src/runtime/process-log.mjs"
  },
  "bin": {
    "summon-bot": "./bin/summon-bot.mjs"
  },
  "files": [
    "src",
    "bin",
    "examples",
    "third_party",
    "README.md"
  ],
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "ignore": "7.0.8",
    "yaml": "2.9.0",
    "zod": "4.6.7"
  }
}
