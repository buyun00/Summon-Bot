{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Summon Bot",
  "version": "0.5.32",
  "identifier": "org.lin0.relay.desktop.tauri",
  "build": {
    "frontendDist": "../setup-dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installerHooks": "./nsis/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "./entitlements.mac.plist",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    }
  }
}
