# Local credentials and configuration
.env
.env.*
!.env.example
!.env.sample

# Local runtime state and logs
.relay/
logs/
*.log

# Dependencies and interpreter caches, if introduced later
node_modules/
.venv/
__pycache__/
*.py[cod]

# Operating system metadata
.DS_Store
Thumbs.db
Desktop.ini

# Immutable release artifacts; mutable data lives outside the repository
dist/
*.building-*/
desktop/release.json

# Xcode local state and build output
ios/DerivedData/
ios/build/
ios/**/*.xcuserstate
ios/**/xcuserdata/
