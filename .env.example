# Deployment configuration lives in <data-root>/config/deployment.json.
# Put actual credentials in <data-root>/config/runtime.env; never commit them.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Optional explicit locations for CLI/PowerShell launchers:
SUMMON_DATA_ROOT=D:/Relay-Bot-data
SUMMON_RELEASE_ROOT=
