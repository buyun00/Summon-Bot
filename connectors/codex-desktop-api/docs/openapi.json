    "/v1/events": {
      "get": {
        "summary": "Subscribe to SSE and replay retained events",
        "description": "Events: stream.ready, threads.changed, thread.snapshot, thread.status, item.updated, output.delta, thread.gap, desktop.disconnected, desktop.protocol_mismatch. threadId subscribes explicitly; omitted means monitored chats. Initial snapshots have no event ID. Last-Event-ID refers to this service journal; expired cursors return 409. Streams contain visible content, not private reasoning.",
        "parameters": [
          {
            "name": "threadId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "hostId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "local"
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "Last-Event-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SSE stream, heartbeat every 15 seconds",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "description": "Cursor expired",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
