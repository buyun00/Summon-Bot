    "/v1/account/usage": {
      "get": {
        "summary": "Read weekly account usage from the local desktop",
        "description": "Read-only, existing Bearer policy. No query parameters. Uses configured local caller context; identifies weekly primary/secondary windows by 10080 minutes. Prefers nonempty rateLimitsByLimitId over legacy rateLimits. Missing data is null with notes. Unsupported tool: 501; missing context/disconnected desktop: 503; upstream failure: 502. No reset or credit redemption.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Fresh desktop read. Percent capacity is normalized to 100, not an absolute allowance. Start is derived from reset minus duration; observedAt is bridge receipt time. Missing fields are null with notes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountUsage"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
