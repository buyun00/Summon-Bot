                  "hostId": {
                    "type": "string",
                    "default": "local"
                  },
                  "model": {
                    "type": "string",
                    "minLength": 1
                  },
                  "thinking": {
                    "type": "string",
                    "enum": [
                      "none",
                      "minimal",
                      "low",
                      "medium",
                      "high",
                      "xhigh",
