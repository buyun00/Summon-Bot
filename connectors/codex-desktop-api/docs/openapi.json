    "/v1/threads": {
      "get": {
        "summary": "List recent and pinned desktop chats",
        "description": "limit applies to recent unpinned chats. All pinned chats are included. status is filtered after that window; this is not a globally paginated query.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 50,
              "minimum": 1,
              "maximum": 50
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
