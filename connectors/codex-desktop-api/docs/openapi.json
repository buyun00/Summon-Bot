{
  "openapi": "3.1.0",
  "info": {
    "title": "Codex Desktop API",
    "version": "0.1.0",
    "description": "Windows local desktop bridge with an API testing page. Private desktop IPC, tested with 26.1021.3705.0. Bearer authentication is required for remote/forwarded requests or when explicitly enabled. Local loopback bypass is configurable. Existing local caller thread context is configured at installation."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:47831"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
