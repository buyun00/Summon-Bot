            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a desktop chat and submit its initial prompt",
        "description": "Reads the saved local desktop permission selection and verifies a loaded local calling context with matching built-in profile, sandbox, approval policy and reviewer before submitting the original prompt once. No bootstrap turn or post-start permission repair. Returns permissionInheritance evidence. Missing defaults/context or unsupported custom/profile/server-default selection fails before creation. Creation accepted but subsequent verification unavailable/mismatched reports an unknown outcome with threadId; never retry with a new idempotency key. Tested permission inheritance: Windows desktop 26.1027.3384.0, agent modes full-access/read-only/auto/granular; real write verification covers full-access + never only.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]+$"
            },
            "description": "Unique per logical mutation. Persist and reuse the exact key and body after a timeout."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateThread"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Success. Upstream payloads may contain their own status or queued result; HTTP acceptance is not task completion.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
